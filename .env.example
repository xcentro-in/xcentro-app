# Backend API URL
# This should be set during Docker build or deployment
# For local development, use localhost without the /v1 suffix
VITE_API_URL=http://localhost:8888

# Example production URL:
# VITE_API_URL=https://api.xcentro.in/v1

# Example staging URL:
# VITE_API_URL=https://api-staging.xcentro.in/v1

# Example development URL:
# VITE_API_URL=https://api-dev.xcentro.in/v1

# Cloudflare Turnstile Site Key (Production only)
# Get your site key from: https://dash.cloudflare.com/?to=/:account/turnstile
# Leave empty for development (Turnstile will be automatically disabled)
# Bot protection will only activate when this key is set AND running in production mode
VITE_TURNSTILE_SITE_KEY=

# Example production key (replace with your actual key):
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAABCDEFxxxxxxxxxx

# Testing keys (always pass/always block):
# Always passes: 1x00000000000000000000AA
# Always blocks:  2x00000000000000000000AB
# Force challenge: 3x00000000000000000000FF

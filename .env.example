# Backend API URL
# This should be set during Docker build or deployment
VITE_API_URL=http://localhost:8888/v1

# Example production URL:
# VITE_API_URL=https://api.paysphere.com/v1

# Example staging URL:
# VITE_API_URL=https://api-staging.paysphere.com/v1

# Example development URL:
# VITE_API_URL=https://api-dev.paysphere.com/v1
